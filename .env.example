# Valores FICTÍCIOS. Em produção, cadastre no painel da Hostinger; NUNCA no repositório.

# --- Banco de dados (obrigatórios) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nova_berith
DB_USER=usuario_exemplo
DB_PASSWORD=troque-esta-senha
DB_POOL_LIMIT=5

# --- Aplicação (obrigatórios) ---
NODE_ENV=production
# Segredo longo e aleatório (48+ caracteres): npm run gerar:segredo
SESSION_SECRET=gere-com-npm-run-gerar-segredo
# Endereço público (https). Usado nos links de convite/senha.
APP_URL=https://app.exemplo.invalid

# --- Arquivos privados (fotos, PDFs, áudios, comprovantes) ---
# Aponte para um diretório PERSISTENTE e com backup (fora de public/). Confirmar persistência no hPanel.
STORAGE_DIR=/caminho/persistente/nova-berith-arquivos

# --- Agendador e Web Push (opcionais, mas necessários para lembretes/push) ---
# Segredo do agendador (24+ caracteres): npm run gerar:segredo
CRON_SECRET=
# Chaves VAPID: npm run gerar:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.invalid

# --- E-mail (opcional; sem ele, links de convite e de senha são entregues manualmente) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Nova Berith <nao-responda@exemplo.invalid>"
